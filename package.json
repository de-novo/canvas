{
  "name": "@de-novo/canvas-monorepo",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "build:pages": "node scripts/build-pages-site.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "verify:browser-rendering": "node scripts/verify-browser-rendering.mjs",
    "verify:browser-rendering-adapters": "node scripts/verify-browser-rendering-adapters.mjs",
    "verify:bim-rendering": "pnpm --filter @de-novo/canvas-bim-example copy:wasm && ADAPTER_ONLY=Bim node scripts/verify-browser-rendering-adapters.mjs",
    "verify:bim-federation": "pnpm --filter @de-novo/canvas-bim-example copy:wasm && node scripts/verify-bim-federation.mjs",
    "verify:bim-worker": "node scripts/verify-bim-worker.mjs",
    "verify:diagram-rendering": "ADAPTER_ONLY=Diagram node scripts/verify-browser-rendering-adapters.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:denovo-field": "node scripts/verify-denovo-field.mjs",
    "verify:denovo-sparkline": "node scripts/verify-denovo-sparkline.mjs",
    "verify:vgpu-catalog": "node scripts/verify-vgpu-catalog.mjs",
    "verify:document-schema": "node scripts/verify-document-schema.mjs",
    "verify:editor-core": "node scripts/verify-editor-core.mjs",
    "verify:field-showcase": "node scripts/verify-field-showcase.mjs",
    "verify:flow-showcase": "node scripts/verify-flow-showcase.mjs",
    "verify:named-operations": "pnpm --filter @de-novo/canvas-bim-example copy:wasm && node scripts/verify-named-operations.mjs",
    "verify:network-showcase": "node scripts/verify-network-showcase.mjs",
    "verify:hit-testing": "node scripts/verify-hit-testing.mjs",
    "verify:m4-performance": "node scripts/verify-m4-performance.mjs",
    "verify:mesh-surface": "node scripts/verify-mesh-surface.mjs",
    "verify:public-api": "node scripts/verify-public-api.mjs",
    "verify:pages": "node scripts/verify-pages-site.mjs",
    "verify:pack-smoke": "node scripts/verify-pack-smoke.mjs",
    "verify:region-mask": "node scripts/verify-region-mask.mjs",
    "verify:webgpu": "node scripts/verify-webgpu.mjs",
    "verify:2d-performance": "node scripts/verify-2d-performance.mjs",
    "verify:performance": "node scripts/verify-performance.mjs",
    "verify:point-field": "node scripts/verify-point-field.mjs",
    "verify:selectors": "node scripts/verify-selectors.mjs",
    "verify:server": "node scripts/verify-server.mjs",
    "verify:worker-tasks": "node scripts/verify-worker-tasks.mjs"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.3",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.1",
    "tsup": "^9.0.0",
    "turbo": "^2.11.12",
    "typescript": "^7.0.2"
  }
}
