{
  "name": "@denovo/canvas-bim",
  "version": "0.0.0",
  "description": "Optional BIM adapter contracts and web-ifc integration for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web-ifc": {
      "types": "./dist/web-ifc-adapter.d.ts",
      "import": "./dist/web-ifc-adapter.js",
      "require": "./dist/web-ifc-adapter.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/web-ifc-adapter.ts --format esm,cjs --clean --external @denovo/canvas-core --external web-ifc && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@denovo/canvas-core": "workspace:*",
    "web-ifc": ">=0.0.77"
  },
  "peerDependenciesMeta": {
    "web-ifc": {
      "optional": true
    }
  },
  "dependencies": {
    "@denovo/canvas-core": "workspace:*"
  },
  "devDependencies": {
    "@denovo/canvas-core": "workspace:*",
    "web-ifc": "^0.0.77"
  }
}
