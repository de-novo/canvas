{
  "name": "@de-novo/canvas-bim",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Optional BIM adapter contracts and web-ifc integration for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./web-ifc": {
      "types": "./dist/web-ifc-adapter.d.ts",
      "import": "./dist/web-ifc-adapter.js",
      "require": "./dist/web-ifc-adapter.cjs"
    },
    "./web-ifc-worker": {
      "types": "./dist/web-ifc-worker.d.ts",
      "import": "./dist/web-ifc-worker.js",
      "require": "./dist/web-ifc-worker.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/web-ifc-adapter.ts src/web-ifc-worker.ts src/worker-adapter.ts --format esm,cjs --clean --external @de-novo/canvas-core --external @de-novo/canvas-worker --external web-ifc && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@de-novo/canvas-core": "workspace:*",
    "@de-novo/canvas-worker": "workspace:*",
    "web-ifc": ">=0.0.77"
  },
  "peerDependenciesMeta": {
    "@de-novo/canvas-worker": {
      "optional": true
    },
    "web-ifc": {
      "optional": true
    }
  },
  "dependencies": {
    "@de-novo/canvas-core": "workspace:*"
  },
  "devDependencies": {
    "@de-novo/canvas-core": "workspace:*",
    "@de-novo/canvas-worker": "workspace:*",
    "web-ifc": "^0.0.77"
  },
  "homepage": "https://github.com/de-novo/canvas#readme",
  "bugs": {
    "url": "https://github.com/de-novo/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/canvas.git",
    "directory": "packages/bim"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "canvas",
    "2d",
    "3d",
    "editor",
    "typescript",
    "webgpu",
    "denovo"
  ]
}
