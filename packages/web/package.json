{
  "name": "@denovo/canvas-web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Framework-agnostic 2D/3D DOM canvas runtime for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./2d": {
      "types": "./dist/2d.d.ts",
      "import": "./dist/2d.js",
      "require": "./dist/2d.cjs"
    },
    "./3d": {
      "types": "./dist/3d.d.ts",
      "import": "./dist/3d.js",
      "require": "./dist/3d.cjs"
    },
    "./indexed-db": {
      "types": "./dist/indexed-db.d.ts",
      "import": "./dist/indexed-db.js",
      "require": "./dist/indexed-db.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/2d.ts src/3d.ts src/indexed-db.ts --format esm,cjs --clean --external three --external three/webgpu --external three-mesh-bvh --external @denovo/canvas-core --external @denovo/canvas-three --external @denovo/canvas-editor && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@denovo/canvas-core": "workspace:*",
    "@denovo/canvas-editor": "workspace:*",
    "@denovo/canvas-three": "workspace:*",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "@types/three": "^0.185.0"
  }
}
