{
  "name": "@denovo/canvas",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "User-facing facade for Denovo Canvas 2D/3D view and edit workflows.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./2d": {
      "types": "./dist/2d.d.ts",
      "import": "./dist/2d.js",
      "require": "./dist/2d.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react/2d": {
      "types": "./dist/react-2d.d.ts",
      "import": "./dist/react-2d.js",
      "require": "./dist/react-2d.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./indexed-db": {
      "types": "./dist/indexed-db.d.ts",
      "import": "./dist/indexed-db.js",
      "require": "./dist/indexed-db.cjs"
    },
    "./react-query": {
      "types": "./dist/react-query.d.ts",
      "import": "./dist/react-query.js",
      "require": "./dist/react-query.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "sideEffects": [
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/2d.ts src/react.ts src/react-2d.ts src/worker.ts src/indexed-db.ts src/react-query.ts src/web.ts --format esm,cjs --clean --external effect --external @denovo/canvas-core --external @denovo/canvas-editor --external @denovo/canvas-web --external @denovo/canvas-web/2d --external @denovo/canvas-worker --external @denovo/react-canvas --external @denovo/react-canvas/2d --external @tanstack/react-query && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@denovo/canvas-core": "workspace:*",
    "@denovo/canvas-editor": "workspace:*",
    "@denovo/canvas-web": "workspace:*",
    "@denovo/canvas-worker": "workspace:*",
    "effect": "3.21.4"
  },
  "peerDependencies": {
    "@denovo/react-canvas": "workspace:*",
    "@tanstack/react-query": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@denovo/react-canvas": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0"
  },
  "homepage": "https://github.com/de-novo/canvas#readme",
  "bugs": {
    "url": "https://github.com/de-novo/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/canvas.git",
    "directory": "packages/canvas"
  },
  "publishConfig": {
    "access": "public"
  }
}
