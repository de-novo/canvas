{
  "name": "@denovo/svelte-canvas",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Svelte adapter for Denovo Canvas.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./2d": {
      "types": "./dist/2d.d.ts",
      "svelte": "./src/2d.ts",
      "import": "./src/2d.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@denovo/canvas": "workspace:*",
    "@denovo/canvas-core": "workspace:*",
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "@denovo/canvas": "workspace:*",
    "@denovo/canvas-core": "workspace:*",
    "svelte": "^5.19.0"
  },
  "homepage": "https://github.com/de-novo/canvas#readme",
  "bugs": {
    "url": "https://github.com/de-novo/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/canvas.git",
    "directory": "packages/svelte-canvas"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "canvas",
    "2d",
    "3d",
    "editor",
    "typescript",
    "webgpu",
    "denovo"
  ]
}
