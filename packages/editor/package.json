{
  "name": "@denovo/canvas-editor",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Framework-agnostic command, transaction, selection, and history runtime for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --external effect --external @denovo/canvas-core && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@denovo/canvas-core": "workspace:*",
    "effect": "3.21.4"
  },
  "homepage": "https://github.com/de-novo/canvas#readme",
  "bugs": {
    "url": "https://github.com/de-novo/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/canvas.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "canvas",
    "2d",
    "3d",
    "editor",
    "typescript",
    "webgpu",
    "denovo"
  ]
}
