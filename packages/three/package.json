{
  "name": "@denovo/canvas-three",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Three.js performance primitives for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --external three --external three-mesh-bvh --external @denovo/canvas-core && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": ">=0.185.1",
    "three-mesh-bvh": ">=0.9.0"
  },
  "dependencies": {
    "@denovo/canvas-core": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.10"
  },
  "homepage": "https://github.com/de-novo/canvas#readme",
  "bugs": {
    "url": "https://github.com/de-novo/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/canvas.git",
    "directory": "packages/three"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "canvas",
    "2d",
    "3d",
    "editor",
    "typescript",
    "webgpu",
    "denovo"
  ]
}
