{
  "name": "@de-novo/react-canvas",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "React adapter for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./2d": {
      "types": "./dist/2d.d.ts",
      "import": "./dist/2d.js",
      "require": "./dist/2d.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx src/2d.tsx --format esm,cjs --clean --external react --external react/jsx-runtime --external three --external @react-three/fiber --external @react-three/drei --external @de-novo/canvas --external @de-novo/canvas/2d --external @de-novo/canvas-core --external @de-novo/canvas-three && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@de-novo/canvas": "workspace:*",
    "@de-novo/canvas-core": "workspace:*",
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "react": ">=18.3.0 <20",
    "three": ">=0.185.1"
  },
  "dependencies": {
    "@de-novo/canvas-three": "workspace:*"
  },
  "devDependencies": {
    "@de-novo/canvas": "workspace:*",
    "@de-novo/canvas-core": "workspace:*",
    "@de-novo/canvas-three": "workspace:*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/react": "^19.2.17",
    "@types/three": "^0.185.0",
    "react": "^19.2.7",
    "three": "^0.185.1"
  },
  "homepage": "https://github.com/de-novo/canvas#readme",
  "bugs": {
    "url": "https://github.com/de-novo/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/canvas.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "canvas",
    "2d",
    "3d",
    "editor",
    "typescript",
    "webgpu",
    "denovo"
  ]
}
