{
  "name": "@denovo/canvas-server",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Server-side scene utilities for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js",
      "require": "./dist/filesystem.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/filesystem.ts --format esm,cjs --clean --external @denovo/canvas-core --external @denovo/canvas-editor && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@denovo/canvas-core": "workspace:*",
    "@denovo/canvas-editor": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "homepage": "https://github.com/de-novo/canvas#readme",
  "bugs": {
    "url": "https://github.com/de-novo/canvas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/de-novo/canvas.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  }
}
