{
  "name": "@denovo/vue-canvas",
  "version": "0.0.0",
  "description": "Vue adapter for Denovo Canvas.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --external vue --external @denovo/canvas-core --external @denovo/canvas-web && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@denovo/canvas-core": "workspace:*",
    "@denovo/canvas-web": "workspace:*",
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@denovo/canvas-core": "workspace:*",
    "@denovo/canvas-web": "workspace:*",
    "vue": "^3.5.13"
  }
}
